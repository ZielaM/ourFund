# Local development: copy to .env. The values below match compose.dev.yaml.
DATABASE_URL="postgresql://ourfund:ourfund@localhost:5432/ourfund?schema=public"

# Used by integration tests (pnpm test) and e2e tests (pnpm e2e).
TEST_DATABASE_URL="postgresql://ourfund:ourfund@localhost:5432/ourfund_test?schema=public"
E2E_DATABASE_URL="postgresql://ourfund:ourfund@localhost:5432/ourfund_e2e?schema=public"

# "true" lets anyone who can reach the app create an account. Off by default:
# the administrator creates accounts on the "Użytkownicy" page.
ALLOW_REGISTRATION="false"

# Prices and exchange rates: "live" fetches them from Yahoo Finance and NBP,
# "off" never contacts the internet (prices are entered by hand).
MARKET_DATA="live"
