generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Instance-wide settings (one row per key), e.g. feature switches or job timestamps.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

/// A local account. There is no e-mail: passwords are reset by an administrator.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Stored normalized (trimmed, lower case).
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  /// Set when an administrator blocks the account.
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  portfolios  Portfolio[]
  instruments Instrument[]

  @@map("users")
}

model Session {
  /// SHA-256 of the token kept in the browser cookie; the token itself is never stored.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in history used to slow down password guessing.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  username  String
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([username, createdAt])
  @@map("login_attempts")
}

/// A user's grouping of investment accounts, e.g. "Emerytura" or "Główny".
model Portfolio {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Instrument the portfolio's return is compared with (an index or an ETF tracking one).
  benchmarkInstrumentId String? @map("benchmark_instrument_id") @db.Uuid

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  benchmark Instrument? @relation("PortfolioBenchmark", fields: [benchmarkInstrumentId], references: [id], onDelete: SetNull)
  accounts  Account[]

  @@unique([userId, name])
  @@map("portfolios")
}

/// Polish account wrappers differ in tax treatment: IKE, IKZE and OKI are tax-advantaged.
enum AccountType {
  STANDARD
  IKE
  IKZE
  OKI

  @@map("account_type")
}

/// An account at a broker or bank. Tax lots (FIFO) are tracked per account.
model Account {
  id          String      @id @default(uuid()) @db.Uuid
  portfolioId String      @map("portfolio_id") @db.Uuid
  name        String
  type        AccountType @default(STANDARD)
  /// Broker or bank, free text (e.g. "XTB").
  institution String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([portfolioId, name])
  @@map("accounts")
}

enum InstrumentType {
  STOCK
  ETF
  BOND
  CRYPTO
  /// Not tradable: exists only to be quoted and used as a benchmark.
  INDEX

  @@map("instrument_type")
}

/// A tradable instrument. The catalogue is shared by all users of the instance.
model Instrument {
  id          String         @id @default(uuid()) @db.Uuid
  /// Ticker, stored upper case (e.g. "CDR", "VWCE").
  symbol      String
  /// Market code from the list in src/domain/portfolio/markets.ts (e.g. "GPW").
  market      String
  name        String
  type        InstrumentType
  /// ISO 4217 code of the currency the instrument is quoted in.
  currency    String         @db.Char(3)
  /// Where prices come from: fetched automatically or entered by hand.
  priceSource PriceSource    @default(YAHOO) @map("price_source")
  /// Symbol at the quote provider; null means "derive it from symbol and market".
  quoteSymbol String?        @map("quote_symbol")
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  prices       Price[]
  benchmarkFor Portfolio[]   @relation("PortfolioBenchmark")

  @@unique([symbol, market])
  @@map("instruments")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
  DEPOSIT
  WITHDRAWAL
  SPLIT

  @@map("transaction_type")
}

/// One entry in an account's history. Which fields are used depends on the type;
/// the rules live in src/domain/portfolio/transaction-input.ts.
model Transaction {
  id           String          @id @default(uuid()) @db.Uuid
  accountId    String          @map("account_id") @db.Uuid
  type         TransactionType
  date         DateTime        @db.Date
  instrumentId String?         @map("instrument_id") @db.Uuid
  /// BUY, SELL: number of units.
  quantity     Decimal?        @db.Decimal(28, 10)
  /// BUY, SELL: price of one unit in the instrument's currency.
  price        Decimal?        @db.Decimal(28, 10)
  /// Currency in which cash moved on the account (amount, fee and tax are in it).
  currency     String          @db.Char(3)
  /// Units of `currency` per one unit of the instrument's currency; 1 when they are the same.
  fxRate       Decimal         @default(1) @map("fx_rate") @db.Decimal(18, 8)
  /// DIVIDEND, INTEREST: gross amount. FEE, DEPOSIT, WITHDRAWAL: the amount.
  amount       Decimal?        @db.Decimal(28, 10)
  /// BUY, SELL: commission.
  fee          Decimal         @default(0) @db.Decimal(28, 10)
  /// DIVIDEND, INTEREST: tax withheld at source.
  tax          Decimal         @default(0) @db.Decimal(28, 10)
  /// SPLIT: new units per one old unit (4 for a 4:1 split, 0.1 for a 1:10 reverse split).
  splitRatio   Decimal?        @map("split_ratio") @db.Decimal(18, 8)
  note         String?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([accountId, date])
  @@index([instrumentId])
  @@map("transactions")
}

enum PriceSource {
  YAHOO
  MANUAL

  @@map("price_source")
}

/// Closing price of an instrument on a day, in the instrument's currency.
model Price {
  instrumentId String      @map("instrument_id") @db.Uuid
  date         DateTime    @db.Date
  close        Decimal     @db.Decimal(28, 10)
  source       PriceSource
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([instrumentId, date])
  @@map("prices")
}

/// Average exchange rate published by the National Bank of Poland (table A).
model FxRate {
  currency String   @db.Char(3)
  date     DateTime @db.Date
  /// PLN per one unit of `currency`.
  rate     Decimal  @db.Decimal(18, 8)

  @@id([currency, date])
  @@map("fx_rates")
}
